# ────────────────────────────────────────────────────────────
# Callibr — Environment template
# Copy this file to .env and fill in your real values.
# NEVER commit .env or put real secrets in this file.
# ────────────────────────────────────────────────────────────

# ── Environment ─────────────────────────────────────────────
CALLIBR_ENV=local
CALLIBR_SERVICE_NAME=callibr-api
CALLIBR_API_HOST=0.0.0.0
CALLIBR_API_PORT=8000

# ── Persistence ─────────────────────────────────────────────
CALLIBR_PERSISTENCE_BACKEND=memory       # memory | postgres
CALLIBR_DATABASE_URL=postgresql+psycopg://callibr:callibr@postgres:5432/callibr
CALLIBR_REDIS_URL=redis://redis:6379/0

# ── Demo / Default tenant ───────────────────────────────────
CALLIBR_DEMO_TENANT_ID=tenant_demo
CALLIBR_DEMO_USER_EMAIL=learner@demo.callibr.local
CALLIBR_DEMO_USER_PASSWORD=callibr-demo
CALLIBR_AUTH_TOKEN_TTL_SECONDS=3600

# ── Authentication ──────────────────────────────────────────
# Generate with: openssl rand -base64 32
CALLIBR_AUTH_SECRET=

# ── LLM Provider (at least one required) ────────────────────
CALLIBR_OPENAI_API_KEY=
CALLIBR_OPENAI_MODEL=gpt-4o-mini

# ── OpenRouter (alternative LLM provider) ───────────────────
OPENROUTER_API_KEY=

# ── Google Gemini (alternative LLM provider) ────────────────
GOOGLE_STUDIO_AI_API_KEY_1=
GOOGLE_STUDIO_AI_API_KEY_2=
GOOGLE_STUDIO_AI_API_KEY_3=
GOOGLE_STUDIO_AI_API_KEY_4=
GOOGLE_STUDIO_AI_API_KEY_5=
GOOGLE_STUDIO_AI_API_KEY_6=
GOOGLE_STUDIO_AI_API_KEY_7=
GOOGLE_STUDIO_AI_API_KEY_8=
GOOGLE_STUDIO_AI_MODEL_LINK=

# ── Google OAuth (optional — only needed for SSO) ───────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET_CODE=

# ── Voice (STT / TTS) ───────────────────────────────────────
# Set to "false" to use real providers (requires API keys below)
CALLIBR_MOCK_STT=true
CALLIBR_MOCK_TTS=true

# Deepgram (required if CALLIBR_MOCK_STT=false)
DEEPGRAM_API_KEY=

# ElevenLabs (required if CALLIBR_MOCK_TTS=false)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# ── AI Runtime features (opt-in for pilot) ──────────────────
CALLIBR_AI_RUNTIME_BUDGET_ENABLED=false
CALLIBR_AI_RUNTIME_SAFETY_ENABLED=false
CALLIBR_AI_RUNTIME_REDUCTION_ENABLED=false
CALLIBR_AI_RUNTIME_ROUTING_ENABLED=false
